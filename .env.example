# Copy this file to .env on the Beelink. Never commit the real .env file.
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
ALLOWED_USER_ID=

# Ollama is installed on the same Beelink host.
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120

# Persistent conversation memory and the global heavy-job queue.
POOIA_DB_PATH=/app/data/poo-ia.sqlite3
MEMORY_RETENTION_DAYS=7
MEMORY_MAX_EXCHANGES=10
MEMORY_MAX_CONTEXT_CHARS=12000
OPERATIONAL_RETENTION_DAYS=30
JOB_MAX_CONCURRENT=1

# OpenCode documentation worker. Keep disabled until the host service is tested.
OPENCODE_ENABLED=false
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
# Required when enabled: a random secret of at least 16 characters.
OPENCODE_SERVER_PASSWORD=
OPENCODE_AGENT=capnet-research
OPENCODE_TIMEOUT_SECONDS=300
OPENCODE_MAX_CONCURRENT=1

# Host-side Codex/GitHub worker. Enable only after its service and login are ready.
WORKER_ENABLED=false
WORKER_BASE_URL=http://127.0.0.1:4097
WORKER_SERVER_USERNAME=poo-ia
# Required when enabled: a different random secret of at least 16 characters.
WORKER_SERVER_PASSWORD=
WORKER_TIMEOUT_SECONDS=30
WORKER_POLL_SECONDS=2

# AWS is intentionally deferred for this phase. Keep this false.
AWS_ENABLED=false
