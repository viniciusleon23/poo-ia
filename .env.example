# Copy this file to .env on the Beelink. Never commit the real .env file.
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=

# Ollama is installed on the same Beelink host.
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120

# Optional: leave empty to allow every human in DISCORD_CHANNEL_ID.
ALLOWED_USER_ID=

# OpenCode documentation worker. Keep disabled until the host service is tested.
OPENCODE_ENABLED=false
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_AGENT=capnet-research
OPENCODE_TIMEOUT_SECONDS=300
OPENCODE_MAX_CONCURRENT=1
