# Copy to /home/poo/.config/poo-ia/worker.env and chmod 600.
WORKER_HOST=127.0.0.1
WORKER_PORT=4097
WORKER_USERNAME=poo-ia
# Required: generate a different random secret before starting the service.
WORKER_PASSWORD=

CAPNET_WORKSPACE=/home/poo/capnet-workspace
CAPNET_WORKTREES=/home/poo/capnet-worktrees
WORKER_DATA_ROOT=/home/poo/.local/share/poo-ia-worker
OPERATIONAL_RETENTION_DAYS=30
WORKER_RETENTION_SWEEP_SECONDS=3600

CODEX_EXECUTABLE=/usr/local/bin/codex
GIT_EXECUTABLE=/usr/bin/git
GH_EXECUTABLE=/usr/bin/gh
CODEX_MAX_CHANGED_FILES=5
CODEX_MAX_CHANGED_LINES=400
CODEX_TIMEOUT_SECONDS=1800
VALIDATION_TIMEOUT_SECONDS=600
VALIDATION_ENABLED=false
VALIDATION_BUILD_TIMEOUT_SECONDS=600
DOCKER_EXECUTABLE=/usr/bin/docker
# Host-side read-only AWS queries; credentials stay in the user's shared profile.
AWS_ENABLED=false
AWS_CLI_EXECUTABLE=/home/poo/.local/bin/aws
AWS_PROFILE=default
AWS_REGION=us-east-1
AWS_QUERY_TIMEOUT_SECONDS=20
# Explicit physical table names for the same environment. No guessed defaults.
# Required only for count-planned-tasks; credentials still use AWS_PROFILE.
AWS_TASKS_TABLE=
AWS_DEALER_CONFIG_TABLE=
GITHUB_TIMEOUT_SECONDS=120
WORKER_POLL_SECONDS=0.5
